					<property name="com.jaspersoft.studio.unit.height" value="px"/>
				</reportElement>
				<textElement textAlignment="Left" verticalAlignment="Middle">
					<font size="9" isBold="false"/>
				</textElement>
				<textFieldExpression><![CDATA["Kami sampaikan item - item yang diorder sesuai SP ( terlampir ) senilai Rp. "]]></textFieldExpression>
			</textField>
			<textField>
				<reportElement x="109" y="130" width="460" height="15" uuid="1ced0d0f-403a-47c6-a256-b76ab4318722">
