				<textFieldExpression><![CDATA["Pesanan barang ini selambat - lambatnya sudah kami terima paling lambat tgl"+$F{JTEMPO}+''.'']]></textFieldExpression>
			</textField>
			<textField>
				<reportElement x="109" y="115" width="571" height="15" uuid="303bb363-89df-425a-9ed6-d0e2abeb4121">
