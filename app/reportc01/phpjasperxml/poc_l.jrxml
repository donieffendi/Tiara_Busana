				</reportElement>
				<textElement textAlignment="Left" verticalAlignment="Middle">
					<font size="9" isBold="false"/>
				</textElement>
				<textFieldExpression><![CDATA["2. Jika barang kosong/tidak musim, dapat diganti dengan jenis lain yang relatif sama yang disesuaikan"]]></textFieldExpression>
			</textField>
