				</reportElement>
				<textElement textAlignment="Left" verticalAlignment="Middle">
					<font size="9" isBold="false"/>
				</textElement>
				<textFieldExpression><![CDATA["1. Lembar I dan II Lampiran SP harus disertakan pada pengiriman barang, kecuali pengiriman lewat ekspedisi boleh dengan lembar II saja."]]></textFieldExpression>
			</textField>
